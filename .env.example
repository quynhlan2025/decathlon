# Environment: dev | prod
ENV=prod

# Region override (optional — default runs both VN and SG)
# REGION=SG

# Parallelism
WORKERS=4

# CI sharding (e.g. SHARD=1/4 runs first quarter of tests)
# SHARD=1/4

# Test accounts (override defaults in constants/test-data.ts)
BUYER_VN_EMAIL=buyer.vn@decathlon.test
BUYER_VN_PASSWORD=Buyer@123
BUYER_SG_EMAIL=buyer.sg@decathlon.test
BUYER_SG_PASSWORD=Buyer@123

SELLER_VN_EMAIL=seller.vn@decathlon.test
SELLER_VN_PASSWORD=Seller@123
SELLER_SG_EMAIL=seller.sg@decathlon.test
SELLER_SG_PASSWORD=Seller@123

# Allure reporting (optional)
# ALLURE_RESULTS_DIR=allure-results
